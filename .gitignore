# In your project directory
cat > .gitignore << 'EOF'
# Environment & secrets
.env
*.env
.env.*

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
venv/
.venv/
env/

# Session data & memory
sessions/
*.json
!package.json

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Ollama / model cache
models/
*.gguf
*.bin
EOF